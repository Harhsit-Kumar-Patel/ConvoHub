PORT=5001
# Use this when MongoDB is running without authentication.
MONGODB_URI=mongodb://127.0.0.1:27017/convohub
# Use this when connecting a local server to the Docker Compose MongoDB.
# MONGODB_URI=mongodb://admin:changeme@127.0.0.1:27017/convohub?authSource=admin
JWT_SECRET=dev_secret_key_change_me_in_production
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
